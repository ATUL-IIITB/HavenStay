<% layout("/layouts/boilerplate.ejs") %>

    <h1>
        <b>
            <%= listing.name %>
        </b>
    </h1>

    <div class="bigImage">
        <img src="<%= listing.Image %>" alt="<%= listing.name %>">
    </div>

    <ul id="details">
        <li><b>Location :</b>
            <%= listing.location %>
        </li>

        <li><b>Description :</b>
            <%= listing.description %>
        </li>

        <li><b>Pricing : ₹</b>
            <%= listing.price.toLocaleString("en-IN") %>
        </li>
    </ul>

    <div class="buttons">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">
            Edit
        </a>
        <form action="/listings/<%=listing._id%>?_method=Delete" method="post">
            <button class="btn btn-danger">
                Delete
            </button>
        </form>


        <a href="/listings" class="btn btn-secondary">
            Back
        </a>

    </div>
    <div class="review">
        <h4>
            Drop a Review
        </h4>
        <form action="/listings/<%= listing.id %>/reviews " method="post" class="form-label needs-validation"
            novalidate>
            <div class="rating mb-3 mt-3">
                <label for="rating">Rating</label>
                <input type="range" id="rating" min="1" max="5" name="review[rating]">
            </div>
            <div class="comment mb-3 mt-3">
                <label for="comment">comment</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                    required></textarea>
                <div class="invalid-feedback">
                    please submit a valid response
                </div>
            </div>

            <button class="btn btn-outline-dark mb-3 mt-3">submit</button>

            <hr>
            <br>

        </form>
        <h4>ALL Reviews</h4>
            <% for(review of listing.reviews){%>
                <li><%= review.comment %> , <b> <%= review.rating %> star </b>  
                     <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"  method="POST">
                        <button class="btn btn-danger btn-sm">Delete</button>
                     </form>
                </li>
                
             <% }%>
    </div>