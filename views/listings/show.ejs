<% layout("/layouts/boilerplate.ejs") %>

<div class="wl-hero">

    <% if (listing.Image && listing.Image.url) { %>
        <img src="<%= listing.Image.url %>" alt="<%= listing.name %>" class="wl-hero__image">
    <% } else { %>
        <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=1200" alt="Default Image" class="wl-hero__image">
    <% } %>

    <div class="wl-ticket">

        <div class="wl-ticket__main">
            <p class="wl-eyebrow"><%= listing.location %></p>
            <h1><%= listing.name %></h1>
            <p class="wl-ticket__host">
                Hosted by <strong><%= listing.owner ? listing.owner.username : "Unknown" %></strong>
            </p>
        </div>

        <div class="wl-ticket__stub">
            <span class="wl-eyebrow">Rate</span>
            <span class="wl-ticket__price">₹<%= listing.price.toLocaleString("en-IN") %></span>
            <span class="wl-ticket__night">per night</span>
        </div>

    </div>

</div>

<div class="wl-listing-body">

    <h3 class="wl-eyebrow" style="font-size: 0.8rem;">About this stay</h3>
    <p class="wl-description"><%= listing.description %></p>

    <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>

        <div class="d-flex gap-2 mt-3">

            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">
                Edit
            </a>

            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button class="btn btn-danger">
                    Delete
                </button>
            </form>

        </div>

    <% } %>

</div>

<div class="wl-divider"></div>

<% if (currUser) { %>

    <div class="wl-review-form">

        <h3 class="mb-4 text-center">Leave a Review</h3>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

            <div class="mb-4 text-center">

                <label class="form-label fw-bold d-block mb-2">Your Rating</label>

                <fieldset class="wl-star-rating">

                    <input type="radio" id="rate5" name="review[rating]" value="5" />
                    <label for="rate5" title="Amazing"><span class="visually-hidden">5 stars</span></label>

                    <input type="radio" id="rate4" name="review[rating]" value="4" />
                    <label for="rate4" title="Very Good"><span class="visually-hidden">4 stars</span></label>

                    <input type="radio" id="rate3" name="review[rating]" value="3" checked />
                    <label for="rate3" title="Good"><span class="visually-hidden">3 stars</span></label>

                    <input type="radio" id="rate2" name="review[rating]" value="2" />
                    <label for="rate2" title="Fair"><span class="visually-hidden">2 stars</span></label>

                    <input type="radio" id="rate1" name="review[rating]" value="1" />
                    <label for="rate1" title="Poor"><span class="visually-hidden">1 star</span></label>

                </fieldset>

            </div>

            <div class="mb-3">

                <label for="comment" class="form-label fw-bold">Comment</label>

                <textarea id="comment" class="form-control" rows="5" name="review[comment]"
                    placeholder="Share your experience..." required></textarea>

                <div class="invalid-feedback">
                    Please write your review.
                </div>

            </div>

            <div class="text-center">
                <button class="btn btn-dark">
                    Submit Review
                </button>
            </div>

        </form>

    </div>

<% } %>

<div class="wl-divider"></div>

<h2 class="text-center mb-4">Guest Reviews</h2>

<div class="review-container">

    <% if (listing.reviews.length === 0) { %>

        <div class="wl-empty-state">
            <p>No reviews yet. Be the first to review this listing!</p>
        </div>

    <% } %>

    <% for (let review of listing.reviews) { %>

        <div class="wl-review-card">

            <div class="wl-stamp" data-rating="<%= review.rating %>">
                <span class="wl-stamp__number"><%= review.rating %></span>
                <span class="wl-stamp__label">/ 5</span>
            </div>

            <div class="wl-review-card__body">

                <div class="d-flex justify-content-between align-items-start">
                    <h6 class="mb-1">
                        <strong><%= review.author ? review.author.username : "Unknown User" %></strong>
                    </h6>

                    <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>

                        <form
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                            method="POST">

                            <button class="btn btn-outline-danger btn-sm">
                                Delete
                            </button>

                        </form>

                    <% } %>

                </div>

                <p class="wl-review-card__text"><%= review.comment %></p>

            </div>

        </div>

    <% } %>

</div>
