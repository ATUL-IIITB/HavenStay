<% layout("/layouts/boilerplate.ejs") %>

<div class="wl-form-page">

    <p class="wl-eyebrow text-center">List your place</p>
    <h1 class="text-center">Tell us about your stay</h1>

    <div class="wl-form-card">

        <form
            action="/listings"
            method="POST"
            enctype="multipart/form-data"
            class="needs-validation"
            novalidate>

            <div class="mb-3">
                <label for="name" class="form-label">Name</label>

                <input
                    type="text"
                    class="form-control"
                    id="name"
                    name="listing[name]"
                    placeholder="e.g. Sunset Villa, Goa"
                    required>

                <div class="invalid-feedback">
                    Please enter the hotel name.
                </div>
            </div>

            <div class="mb-3">
                <label for="Image" class="form-label">Photo</label>

                <input
                    type="file"
                    class="form-control"
                    id="Image"
                    name="listing[Image]"
                    accept="image/*"
                    required>

                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>

                <textarea
                    class="form-control"
                    id="description"
                    name="listing[description]"
                    placeholder="What makes this place special?"
                    rows="5"
                    required></textarea>

                <div class="invalid-feedback">
                    Please provide a description.
                </div>
            </div>

            <div class="row">

                <div class="col-sm-6 mb-3">
                    <label for="price" class="form-label">Price / night</label>

                    <input
                        type="number"
                        class="form-control"
                        id="price"
                        name="listing[price]"
                        placeholder="e.g. 4500"
                        min="0"
                        required>

                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>

                <div class="col-sm-6 mb-3">
                    <label for="location" class="form-label">Location</label>

                    <input
                        type="text"
                        class="form-control"
                        id="location"
                        name="listing[location]"
                        placeholder="e.g. Panjim, Goa"
                        required>

                    <div class="invalid-feedback">
                        Please enter the location.
                    </div>
                </div>

            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">
                List this place
            </button>

        </form>

    </div>

</div>
