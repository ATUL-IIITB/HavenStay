<% layout("/layouts/boilerplate.ejs") %>

<div class="wl-form-page">

    <p class="wl-eyebrow text-center">Edit listing</p>
    <h1 class="text-center"><%= listing.name %></h1>

    <div class="wl-form-card">

        <form
            action="/listings/<%= listing._id %>?_method=PUT"
            method="POST"
            enctype="multipart/form-data"
            class="needs-validation"
            novalidate>

            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input
                    type="text"
                    class="form-control"
                    id="name"
                    name="listing[name]"
                    value="<%= listing.name %>"
                    required>

                <div class="invalid-feedback">
                    Please enter the hotel name.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Current photo</label><br>

                <% if (listing.Image && listing.Image.url) { %>
                    <img
                        src="<%= listing.Image.url %>"
                        alt="<%= listing.name %>"
                        class="wl-edit-thumb">
                <% } %>
            </div>

            <div class="mb-3">
                <label for="Image" class="form-label">Replace photo</label>
                <input
                    type="file"
                    class="form-control"
                    id="Image"
                    name="listing[Image]"
                    accept="image/*">

                <div class="form-text">
                    Leave empty to keep the current photo.
                </div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea
                    class="form-control"
                    id="description"
                    name="listing[description]"
                    rows="5"
                    required><%= listing.description %></textarea>

                <div class="invalid-feedback">
                    Please provide a description.
                </div>
            </div>

            <div class="row">

                <div class="col-sm-6 mb-3">
                    <label for="price" class="form-label">Price / night</label>
                    <input
                        type="number"
                        class="form-control"
                        id="price"
                        name="listing[price]"
                        value="<%= listing.price %>"
                        min="0"
                        required>

                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>

                <div class="col-sm-6 mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input
                        type="text"
                        class="form-control"
                        id="location"
                        name="listing[location]"
                        value="<%= listing.location %>"
                        required>

                    <div class="invalid-feedback">
                        Please enter a location.
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-success flex-fill">
                    Save changes
                </button>

                <a href="/listings/<%= listing._id %>" class="btn btn-secondary flex-fill text-center">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>
